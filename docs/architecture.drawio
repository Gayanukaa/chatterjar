<mxfile host="the-room-app"><diagram name="architecture" id="arch"><mxGraphModel dx="2100" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;The room app architecture&lt;/b&gt; &lt;font color=&quot;#666666&quot;&gt;Planned architecture: about 90 phones poll every 3 s; Next.js 16 App Router on Vercel; Upstash Redis. Arrows show how data flows.&lt;/font&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="1750" height="40" as="geometry" /></mxCell><mxCell id="z1" value="1. Users and devices" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="270" height="800" as="geometry" /></mxCell><mxCell id="a1" value="&lt;b&gt;Student phones (about 90)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;anonymous; open / from the QR code; 360 px width first&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z1"><mxGeometry x="20" y="45" width="230" height="88" as="geometry" /></mxCell><mxCell id="a1_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Device_Phone_Mobile.svg;" vertex="1" parent="a1"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="a1_live" value="LIVE: 3 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d7600;strokeColor=#ffffff;fontColor=#ffffff;fontSize=9;fontStyle=1;strokeWidth=1;" vertex="1" parent="a1"><mxGeometry x="152" y="-9" width="72" height="18" as="geometry" /></mxCell><mxCell id="a2" value="&lt;b&gt;QR code on the slide&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;points to the production URL /&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z1"><mxGeometry x="20" y="195" width="230" height="88" as="geometry" /></mxCell><mxCell id="a2_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Qr_Code.svg;" vertex="1" parent="a2"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="a3" value="&lt;b&gt;Projector&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;/screen at 1600 x 900, large type; plays round 5 audio&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z1"><mxGeometry x="20" y="345" width="230" height="88" as="geometry" /></mxCell><mxCell id="a3_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/flat-color-icons/1/Video_Projector.svg;" vertex="1" parent="a3"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="a3_live" value="LIVE: 3 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d7600;strokeColor=#ffffff;fontColor=#ffffff;fontSize=9;fontStyle=1;strokeWidth=1;" vertex="1" parent="a3"><mxGeometry x="152" y="-9" width="72" height="18" as="geometry" /></mxCell><mxCell id="a4" value="&lt;b&gt;Lecturer (admin)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;laptop on /admin?key=ADMIN_KEY; runs polls and moderation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z1"><mxGeometry x="20" y="495" width="230" height="88" as="geometry" /></mxCell><mxCell id="a4_i" value="" style="sketch=0;outlineConnect=0;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.authenticated_user;" vertex="1" parent="a4"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="a5" value="&lt;b&gt;Backup link&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;rehearsal build on a separate Vercel project; use it if not live by 1:08&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;dashed=1;" vertex="1" parent="z1"><mxGeometry x="20" y="645" width="230" height="88" as="geometry" /></mxCell><mxCell id="a5_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Rocket_Launch.svg;" vertex="1" parent="a5"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="A1" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#b9d3f0;strokeColor=#6c8ebf;direction=east;" vertex="1" parent="1"><mxGeometry x="296" y="430" width="48" height="60" as="geometry" /></mxCell><mxCell id="t1" value="page loads and taps (QR to /)" style="text;html=1;horizontal=0;fontSize=12;fontStyle=1;fontColor=#3d6aa8;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="40" height="200" as="geometry" /></mxCell><mxCell id="z2" value="2. Next.js 16 pages (browser)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="270" height="800" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;/ (student page)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;tabs Vote, Questions, Quiz; 48 px tap targets; lucide-react icons&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z2"><mxGeometry x="20" y="45" width="230" height="88" as="geometry" /></mxCell><mxCell id="b1_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/User_interface-2531/20_internet-1449.svg;" vertex="1" parent="b1"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="b1_live" value="LIVE: 3 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d7600;strokeColor=#ffffff;fontColor=#ffffff;fontSize=9;fontStyle=1;strokeWidth=1;" vertex="1" parent="b1"><mxGeometry x="152" y="-9" width="72" height="18" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;/screen (projector)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;vote count while open, bars after reveal; top 5 questions; quiz tally bars&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z2"><mxGeometry x="20" y="167" width="230" height="88" as="geometry" /></mxCell><mxCell id="b2_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Presentation_Chart_Bar.svg;" vertex="1" parent="b2"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="b2_live" value="LIVE: 3 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d7600;strokeColor=#ffffff;fontColor=#ffffff;fontSize=9;fontStyle=1;strokeWidth=1;" vertex="1" parent="b2"><mxGeometry x="152" y="-9" width="72" height="18" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;/admin?key=&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;create, open, close, reveal polls; load presets; hide questions; reset quiz&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z2"><mxGeometry x="20" y="289" width="230" height="88" as="geometry" /></mxCell><mxCell id="b3_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Key.svg;" vertex="1" parent="b3"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;3 s polling hook&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;fetch GET /api/state every 3 s, cache no-store; no WebSockets&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z2"><mxGeometry x="20" y="411" width="230" height="88" as="geometry" /></mxCell><mxCell id="b4_i" value="" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.event_time_based;" vertex="1" parent="b4"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="b4_live" value="LIVE: 3 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d7600;strokeColor=#ffffff;fontColor=#ffffff;fontSize=9;fontStyle=1;strokeWidth=1;" vertex="1" parent="b4"><mxGeometry x="152" y="-9" width="72" height="18" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;rid device cookie&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;random UUID, 1 year; set in proxy.ts on the first request&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z2"><mxGeometry x="20" y="533" width="230" height="88" as="geometry" /></mxCell><mxCell id="b5_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Finger_Print.svg;" vertex="1" parent="b5"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;Round media&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;img for .png, pre for .java and .txt, audio for .mp3&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z2"><mxGeometry x="20" y="655" width="230" height="88" as="geometry" /></mxCell><mxCell id="b6_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Photo.svg;" vertex="1" parent="b6"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="A2" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#b7dfae;strokeColor=#82b366;direction=east;" vertex="1" parent="1"><mxGeometry x="626" y="430" width="48" height="60" as="geometry" /></mxCell><mxCell id="t2" value="fetch every 3 s + POST, rid cookie" style="text;html=1;horizontal=0;fontSize=12;fontStyle=1;fontColor=#3f7a2c;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="210" width="40" height="200" as="geometry" /></mxCell><mxCell id="z3" value="3. API route handlers on Vercel (app/api/*)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="50" width="760" height="815" as="geometry" /></mxCell><mxCell id="z3_logo" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Ionicons_Fill_Vol_2-2187/logo-vercel-632.svg;" vertex="1" parent="z3"><mxGeometry x="700" y="4" width="42" height="42" as="geometry" /></mxCell><mxCell id="z3a" value="Student routes (need the rid cookie)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="z3"><mxGeometry x="15" y="50" width="730" height="228" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;GET /api/state&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;active poll (results only if revealed), top 30 visible questions, quiz tally, my votes; 1 s cache&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3a"><mxGeometry x="15" y="42" width="220" height="88" as="geometry" /></mxCell><mxCell id="c1_i" value="" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="c1"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c1_live" value="LIVE: 3 s" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d7600;strokeColor=#ffffff;fontColor=#ffffff;fontSize=9;fontStyle=1;strokeWidth=1;" vertex="1" parent="c1"><mxGeometry x="142" y="-9" width="72" height="18" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;POST /api/vote&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;SADD poll:{id}:voters; if new, HINCRBY votes; else reject&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3a"><mxGeometry x="255" y="42" width="220" height="88" as="geometry" /></mxCell><mxCell id="c2_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Check_Circle.svg;" vertex="1" parent="c2"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;POST /api/question&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;200 chars max; INCR rl:{device} (60 s), reject the 4th&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3a"><mxGeometry x="495" y="42" width="220" height="88" as="geometry" /></mxCell><mxCell id="c3_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Chat_Bubble_Left_Right.svg;" vertex="1" parent="c3"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;POST /api/upvote&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;SADD q:{id}:voters; if new, ZINCRBY q:rank; one upvote per question per device&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3a"><mxGeometry x="15" y="140" width="340" height="80" as="geometry" /></mxCell><mxCell id="c4_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Hand_Thumb_Up.svg;" vertex="1" parent="c4"><mxGeometry x="8" y="17.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c9" value="&lt;b&gt;POST /api/quiz&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;5 answers to a persona (a tie goes to list order); SADD quiz:done, then HINCRBY quiz:tally&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3a"><mxGeometry x="375" y="140" width="340" height="80" as="geometry" /></mxCell><mxCell id="c9_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_User_Group.svg;" vertex="1" parent="c9"><mxGeometry x="8" y="17.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="z3b" value="Admin routes (ADMIN_KEY as ?key= or x-admin-key)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbe8;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;strokeWidth=2;" vertex="1" parent="z3"><mxGeometry x="15" y="292" width="730" height="222" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;Create poll&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;POST /api/admin/* (planned)&lt;br&gt;question, 2 to 4 options, optional media, correct option&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3b"><mxGeometry x="15" y="35" width="220" height="88" as="geometry" /></mxCell><mxCell id="c5_i" value="" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c5"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;Open, close, reveal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;POST /api/admin/* (planned)&lt;br&gt;sets poll:active and the poll status&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3b"><mxGeometry x="255" y="35" width="220" height="88" as="geometry" /></mxCell><mxCell id="c6_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Eye.svg;" vertex="1" parent="c6"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c7" value="&lt;b&gt;Load presets&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;POST /api/admin/* (planned)&lt;br&gt;5 Spot-the-AI rounds + exam question (answer B)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3b"><mxGeometry x="495" y="35" width="220" height="88" as="geometry" /></mxCell><mxCell id="c7_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/integration/1/Queue.svg;" vertex="1" parent="c7"><mxGeometry x="8" y="21.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c8" value="&lt;b&gt;Hide question&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;POST /api/admin/* (planned)&lt;br&gt;set hidden on q:{id}, ZREM it from q:rank; gone for everyone within 3 s&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3b"><mxGeometry x="15" y="135" width="340" height="80" as="geometry" /></mxCell><mxCell id="c8_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Eye_Slash.svg;" vertex="1" parent="c8"><mxGeometry x="8" y="17.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="c10" value="&lt;b&gt;Reset quiz&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;POST /api/admin/* (planned)&lt;br&gt;DEL quiz:tally and quiz:done&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z3b"><mxGeometry x="375" y="135" width="340" height="80" as="geometry" /></mxCell><mxCell id="c10_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Arrow_Path.svg;" vertex="1" parent="c10"><mxGeometry x="8" y="17.0" width="46" height="46" as="geometry" /></mxCell><mxCell id="z3c" value="Rules core (applied in every route)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;strokeWidth=2;" vertex="1" parent="z3"><mxGeometry x="15" y="545" width="730" height="258" as="geometry" /></mxCell><mxCell id="k0" value="rid cookie set in proxy.ts" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="15" y="38" width="168" height="36" as="geometry" /></mxCell><mxCell id="k1" value="Cache-Control: no-store on every route" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="193" y="38" width="168" height="36" as="geometry" /></mxCell><mxCell id="k2" value="1 vote per poll, 1 upvote per question" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="371" y="38" width="168" height="36" as="geometry" /></mxCell><mxCell id="k3" value="3 questions per device per minute" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="549" y="38" width="168" height="36" as="geometry" /></mxCell><mxCell id="k4" value="1 pipeline per round trip, max 2 per state read" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="15" y="80" width="227" height="36" as="geometry" /></mxCell><mxCell id="k5" value="1 s state cache per instance (Upstash budget)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="252" y="80" width="227" height="36" as="geometry" /></mxCell><mxCell id="k6" value="Anonymous: no names, emails or phones" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="489" y="80" width="228" height="36" as="geometry" /></mxCell><mxCell id="ev" value="&lt;b&gt;Quiz personas (on a tie, the first in this order wins)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="z3c"><mxGeometry x="15" y="122" width="400" height="22" as="geometry" /></mxCell><mxCell id="e0" value="&lt;b&gt;Idea&lt;/b&gt;&lt;br&gt;tie rank 1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ece8f8;strokeColor=#6248BE;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="15" y="146" width="135" height="44" as="geometry" /></mxCell><mxCell id="e1" value="&lt;b&gt;Researcher&lt;/b&gt;&lt;br&gt;tie rank 2" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e3eafb;strokeColor=#2D58D2;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="158" y="146" width="135" height="44" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;Freelancer&lt;/b&gt;&lt;br&gt;tie rank 3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5ecdb;strokeColor=#9A6610;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="301" y="146" width="135" height="44" as="geometry" /></mxCell><mxCell id="e3" value="&lt;b&gt;Builder&lt;/b&gt;&lt;br&gt;tie rank 4" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dcefe7;strokeColor=#147A58;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="444" y="146" width="135" height="44" as="geometry" /></mxCell><mxCell id="e4" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;tie rank 5" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f6e0e8;strokeColor=#B5355F;fontSize=11;" vertex="1" parent="z3c"><mxGeometry x="587" y="146" width="135" height="44" as="geometry" /></mxCell><mxCell id="vl" value="&lt;b&gt;Poll status (one active poll at a time)&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="z3c"><mxGeometry x="15" y="196" width="300" height="22" as="geometry" /></mxCell><mxCell id="v0" value="OPEN: votes, no results" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="z3c"><mxGeometry x="15" y="220" width="168" height="34" as="geometry" /></mxCell><mxCell id="v1" value="CLOSED: no new votes" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffe599;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="z3c"><mxGeometry x="193" y="220" width="168" height="34" as="geometry" /></mxCell><mxCell id="v2" value="REVEALED: bars + answer" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="z3c"><mxGeometry x="371" y="220" width="168" height="34" as="geometry" /></mxCell><mxCell id="v3" value="NO ACTIVE POLL" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="z3c"><mxGeometry x="549" y="220" width="168" height="34" as="geometry" /></mxCell><mxCell id="A6" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#f4b6b4;strokeColor=#b85450;direction=south;" vertex="1" parent="z3"><mxGeometry x="356" y="512" width="48" height="34" as="geometry" /></mxCell><mxCell id="t6" value="&lt;b&gt;every request passes the rules core&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#9c3a36;align=left;" vertex="1" parent="z3"><mxGeometry x="410" y="514" width="260" height="22" as="geometry" /></mxCell><mxCell id="A3" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#e6d0ee;strokeColor=#9673a6;direction=east;" vertex="1" parent="1"><mxGeometry x="1446" y="430" width="48" height="60" as="geometry" /></mxCell><mxCell id="t3" value="Redis over REST (max 2 pipelines per read)" style="text;html=1;horizontal=0;fontSize=12;fontStyle=1;fontColor=#7a4f8f;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="200" width="40" height="220" as="geometry" /></mxCell><mxCell id="z4" value="4. Upstash Redis (only database)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="60" width="270" height="800" as="geometry" /></mxCell><mxCell id="r0" value="&lt;b&gt;Upstash for Redis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Vercel Marketplace store; @upstash/redis over HTTPS REST; KV_REST_API_* with UPSTASH_REDIS_REST_* fallback&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z4"><mxGeometry x="20" y="45" width="230" height="105" as="geometry" /></mxCell><mxCell id="r0_i" value="" style="image;aspect=fixed;html=1;points=[];image=https://app.diagrams.net/img/lib/mscae/Cache_including_Redis.svg;" vertex="1" parent="r0"><mxGeometry x="8" y="29.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="r1" value="&lt;b&gt;Active poll&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;poll:active = active poll id or empty&lt;br&gt;poll:{id} = poll JSON&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z4"><mxGeometry x="20" y="173" width="230" height="105" as="geometry" /></mxCell><mxCell id="r1_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Document_Chart_Bar.svg;" vertex="1" parent="r1"><mxGeometry x="8" y="29.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="r2" value="&lt;b&gt;Poll votes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;poll:{id}:votes = hash, option to count&lt;br&gt;poll:{id}:voters = set of device ids&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z4"><mxGeometry x="20" y="301" width="230" height="105" as="geometry" /></mxCell><mxCell id="r2_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Chart_Bar.svg;" vertex="1" parent="r2"><mxGeometry x="8" y="29.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="r3" value="&lt;b&gt;Question wall&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;q:rank = sorted set, id to votes&lt;br&gt;q:{id} = hash text, createdAt, hidden&lt;br&gt;q:{id}:voters = set&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z4"><mxGeometry x="20" y="429" width="230" height="105" as="geometry" /></mxCell><mxCell id="r3_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Chat_Bubble_Left_Right.svg;" vertex="1" parent="r3"><mxGeometry x="8" y="29.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="r4" value="&lt;b&gt;Quiz&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;quiz:tally = hash, persona to count&lt;br&gt;quiz:done = set of device ids&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z4"><mxGeometry x="20" y="557" width="230" height="105" as="geometry" /></mxCell><mxCell id="r4_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Users.svg;" vertex="1" parent="r4"><mxGeometry x="8" y="29.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="r5" value="&lt;b&gt;Rate limit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;rl:{device} = counter with 60 s expiry; max 3 questions per minute&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z4"><mxGeometry x="20" y="685" width="230" height="105" as="geometry" /></mxCell><mxCell id="r5_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Clock.svg;" vertex="1" parent="r5"><mxGeometry x="8" y="29.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="howto" value="&lt;b&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;1. About 90 phones scan the QR code and open /. The projector shows /screen.&lt;br&gt;2. The lecturer runs polls, presets and moderation from /admin?key=.&lt;br&gt;3. Pages poll GET /api/state every 3 s with fetch. Taps send POST requests.&lt;br&gt;4. Every route checks the rules core: rid cookie, no-store, limits, admin key.&lt;br&gt;5. A state read uses at most 2 Redis pipelines, cached 1 s per instance. Redis is the only database.&lt;br&gt;6. Polls, quiz and media come from repo files (zone 5). Merges to main deploy (zone 6).&lt;br&gt;7. A green LIVE badge marks data that refreshes every 3 s. Zone 7 never ships." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="912" width="600" height="200" as="geometry" /></mxCell><mxCell id="z5" value="5. Static content (repo files, bundled at build)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d9f0ec;strokeColor=#4a9a8f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="912" width="480" height="200" as="geometry" /></mxCell><mxCell id="d1" value="&lt;b&gt;public/spot/assets&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;10 files: 4 .png (rounds 1, 4), 2 .java, 2 .txt, 2 .mp3; served by the Vercel CDN; credits in SOURCES.md&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a9a8f;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z5"><mxGeometry x="20" y="45" width="215" height="135" as="geometry" /></mxCell><mxCell id="d1_i" value="" style="sketch=0;outlineConnect=0;fillColor=#7AA116;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket_with_objects;" vertex="1" parent="d1"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="d2" value="&lt;b&gt;data/rounds.json + data/quiz.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;5 Spot-the-AI rounds (answer = the AI option); 5 quiz questions, 5 personas&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a9a8f;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z5"><mxGeometry x="250" y="45" width="215" height="135" as="geometry" /></mxCell><mxCell id="d2_i" value="" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#d9f0ec;strokeColor=#4a9a8f;" vertex="1" parent="d2"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="z6" value="6. Build and deploy" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="912" width="590" height="200" as="geometry" /></mxCell><mxCell id="g1" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Gayanukaa/&lt;br&gt;the-room-app; branch from main, PR, merge&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z6"><mxGeometry x="15" y="45" width="165" height="135" as="geometry" /></mxCell><mxCell id="g1_i" value="" style="dashed=0;outlineConnect=0;html=1;shape=mxgraph.webicons.github;gradientColor=#DFDEDE;" vertex="1" parent="g1"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="g2" value="&lt;b&gt;Vercel production&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Git integration deploys main; vercel --prod as fallback&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=11;" vertex="1" parent="z6"><mxGeometry x="190" y="45" width="165" height="135" as="geometry" /></mxCell><mxCell id="g2_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Ionicons_Fill_Vol_2-2187/logo-vercel-632.svg;" vertex="1" parent="g2"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="g3" value="&lt;b&gt;Environment variables&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;KV_REST_API_URL,&lt;br&gt;KV_REST_API_TOKEN&lt;br&gt;(or UPSTASH_REDIS_REST_*)&lt;br&gt;ADMIN_KEY; vercel env pull .env.local&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=10;" vertex="1" parent="z6"><mxGeometry x="365" y="45" width="210" height="135" as="geometry" /></mxCell><mxCell id="g3_i" value="" style="strokeColor=#ffffff;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeWidth=2;outlineConnect=0;shape=mxgraph.cisco.security.lock;" vertex="1" parent="g3"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="A4" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#b5e0d8;strokeColor=#4a9a8f;direction=north;" vertex="1" parent="1"><mxGeometry x="896" y="868" width="48" height="40" as="geometry" /></mxCell><mxCell id="t4" value="&lt;b&gt;rounds.json, quiz.json, asset paths&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#2e7268;align=left;" vertex="1" parent="1"><mxGeometry x="952" y="872" width="220" height="30" as="geometry" /></mxCell><mxCell id="A5" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#ffd8a8;strokeColor=#d79b00;direction=north;" vertex="1" parent="1"><mxGeometry x="1296" y="868" width="48" height="40" as="geometry" /></mxCell><mxCell id="t5" value="&lt;b&gt;deploys main to production, env vars&lt;/b&gt;" style="text;html=1;fontSize=12;fontColor=#b45f06;align=left;" vertex="1" parent="1"><mxGeometry x="1352" y="872" width="300" height="30" as="geometry" /></mxCell><mxCell id="accept" value="&lt;b&gt;Acceptance checks (Playwright, two browser contexts)&lt;/b&gt;&lt;br&gt;1. A second vote from one device is rejected. A vote from the second device counts.&lt;br&gt;2. A revealed poll shows bars and the correct option on / and on /screen.&lt;br&gt;3. A hidden question disappears from both contexts within 3 s.&lt;br&gt;4. A fourth question inside one minute from one device is rejected with a clear message.&lt;br&gt;5. The quiz shows a persona and the tally goes up by one.&lt;br&gt;6. At 360 px width nothing overflows and all buttons are 48 px or taller." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="600" height="200" as="geometry" /></mxCell><mxCell id="scope" value="&lt;b&gt;Scope cut order if the build is late&lt;/b&gt;&lt;br&gt;1. Remove the animations on /screen.&lt;br&gt;2. Show the quiz tally as plain numbers, not bars.&lt;br&gt;3. Remove the question rate limit (drop check 4).&lt;br&gt;4. Remove the quiz (drop check 5). Vote and the question wall must ship.&lt;br&gt;If production is not live by 1:08, switch to the backup link." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="1150" width="480" height="200" as="geometry" /></mxCell><mxCell id="z7" value="7. Claude Code harness (local only, gitignored)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="1150" width="590" height="200" as="geometry" /></mxCell><mxCell id="h1" value="&lt;b&gt;CLAUDE.md + rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;always-on: style, comments, git, agent-handoff; path-scoped: api, ui, tests, docs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=10;dashed=1;" vertex="1" parent="z7"><mxGeometry x="15" y="45" width="180" height="135" as="geometry" /></mxCell><mxCell id="h1_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/developer/1/Developer_Code.svg;" vertex="1" parent="h1"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="h2" value="&lt;b&gt;Agents + skills&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;forked agents return JSON; ponytail, asd-ste100, impeccable, web-design-guidelines; pr, ship, diagram&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=10;dashed=1;" vertex="1" parent="z7"><mxGeometry x="205" y="45" width="180" height="135" as="geometry" /></mxCell><mxCell id="h2_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/hero-icons/1/Solid_Cpu_Chip.svg;" vertex="1" parent="h2"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="h3" value="&lt;b&gt;Hooks + MCP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Prettier + ESLint after edits; unit tests at Stop; git guard; no em dash; Vercel plugin MCP, context7; claude-mem off&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=62;spacingRight=6;fontSize=10;dashed=1;" vertex="1" parent="z7"><mxGeometry x="395" y="45" width="180" height="135" as="geometry" /></mxCell><mxCell id="h3_i" value="" style="shape=image;html=1;aspect=fixed;image=https://icons.diagrams.net/assets/material-symbols/1/Webhook.svg;" vertex="1" parent="h3"><mxGeometry x="8" y="44.5" width="46" height="46" as="geometry" /></mxCell><mxCell id="A7" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.4;fillColor=#eeeeee;strokeColor=#999999;direction=north;dashed=1;" vertex="1" parent="1"><mxGeometry x="1450" y="1114" width="48" height="34" as="geometry" /></mxCell><mxCell id="t7" value="&lt;b&gt;branch, PR, merge (no Claude co-author)&lt;/b&gt;" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="1506" y="1116" width="264" height="30" as="geometry" /></mxCell><mxCell id="lg" value="&lt;b&gt;Legend:&lt;/b&gt; big arrows = data flow between zones; thin arrows = flow inside a zone; solid border = ships in the live app; dashed border = local only or fallback, never part of the live app; green LIVE badge = refreshes every 3 s by fetch polling (no WebSockets)." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="1362" width="1750" height="26" as="geometry" /></mxCell><mxCell id="i1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a9a8f;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="b6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="1025" /><mxPoint x="650" y="759" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>