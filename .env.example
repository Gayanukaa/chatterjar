# Copy to .env.local, or run `vercel env pull .env.local` after linking the project.

# Upstash Redis REST connection (added by the Vercel Upstash integration).
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random string that unlocks /admin. Generate one with: openssl rand -hex 24
ADMIN_KEY=

# Optional: prefix for every Redis key, so tests and demos never touch live data.
REDIS_PREFIX=
