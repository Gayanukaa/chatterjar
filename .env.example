# Copy to .env.local, or run `vercel env pull .env.local` after linking the project.

# Upstash Redis REST connection (added by the Vercel Upstash integration).
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random string that unlocks /admin. Generate one with: openssl rand -hex 24
ADMIN_KEY=

# Optional: owner key that unlocks /admin/rooms to create invite-only rooms.
# Leave empty to run a single room.
SUPER_ADMIN_KEY=

# Optional: prefix for every Redis key, so tests and demos never touch live data.
REDIS_PREFIX=

# Optional: days to keep votes, questions and quiz answers after the last write.
# Default 30; 0 keeps them forever. Poll definitions never expire.
DATA_TTL_DAYS=

# Optional: client refresh interval in ms (2000 to 15000, default 3000).
# Slower polling saves Vercel edge requests when you run many sessions.
NEXT_PUBLIC_POLL_MS=
